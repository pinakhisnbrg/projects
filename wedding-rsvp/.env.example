# Google Sheets is the ONLY wedding RSVP data store.
# Set in Vercel > Project > Settings > Environment Variables.
GOOGLE_APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
RSVP_WEBHOOK_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_SECRET=GENERATE_SEPARATE_AT_LEAST_32_RANDOM_CHARACTERS

# Optional: WhatsApp Business Cloud API for one-at-a-time testing.
# Bulk opt-in sending runs from Apps Script on a time-driven trigger.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en
